# 复制为 .env 后填写。占位符不能直接用于生产。
NODE_ENV=development
PORT=3000
# 日常用 info：只保留收到消息、命令、警告和错误。debug 会打印签名、QQ 请求、图片处理等细节。
# 用 PM2 启动时以 ecosystem.config.js 为准（生产默认 info），不会被这里的 debug 覆盖。
LOG_LEVEL=info

# QQ 开放平台
QQ_BOT_NAME=<BOT_NAME>
QQ_BOT_APP_ID=<QQ_APP_ID>
QQ_BOT_SECRET=<QQ_APP_SECRET>
# 默认与已验证可通的旧机器人一致；如需改用新文档域名可改为 https://api.bot.qq.com
QQ_API_ROOT=https://api.sgroup.qq.com
QQ_TOKEN_URL=https://bots.qq.com/app/getAppAccessToken
QQ_API_TIMEOUT_MS=15000

# 频道/频道私信发图需要公网可访问的 HTTPS 地址（image 字段）。
# 群聊和 QQ 私信走官方分片上传，不依赖这个地址拉原图。
# 必须与 webhook 同一反代入口，例如 webhook 是 https://example.com/qq/webhook 则填 https://example.com
SERVER_HOST=https://<PUBLIC_HOST>

# 管理页面
JWT_SECRET=<GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES>
ADMIN_USERNAME=<ADMIN_USERNAME>
ADMIN_PASSWORD=<STRONG_ADMIN_PASSWORD>
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_ROLE=admin
CORS_ORIGINS=https://<ADMIN_HOST>

# 本地功能
IMAGE_DATA_DIR=./public/generated
# Linux 服务器用 snap 安装 Chromium 时填包装器路径，不要填包内 chrome 二进制。
# BROWSER_EXECUTABLE_PATH=/snap/bin/chromium
BROWSER_EXECUTABLE_PATH=
# 默认使用 fonts/msyh.ttc（微软雅黑 Regular）。可改成 fonts 目录中的其它文件名。
CJK_FONT_NAME=msyh.ttc
CJK_FONT_PATH=
QA_STORE_PATH=./data/qa/groups
PUSH_DATA_DIR=./data
QA_WRITE_USER_IDS=<QQ_USER_ID_1>,<QQ_USER_ID_2>
LOCAL_COMMAND_TIMEOUT_MS=120000

# 本地 MongoDB（群资料等）。库名使用已建好的 db_bot。
# 未配置时跳过群名拉取，不影响收发消息。
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=db_bot
MONGODB_GROUP_COLLECTION=qq_groups
MONGODB_GROUP_MEMBER_COLLECTION=qq_group_members
MONGODB_GUILD_COLLECTION=qq_guilds
MONGODB_GUILD_MEMBER_COLLECTION=qq_guild_members
# 私聊 / 频道私信的昵称与 openid（或频道用户 id）对应。
MONGODB_USER_COLLECTION=qq_users
# mbtv / mbcd / mbzz 记住用户所选服务器（openid -> ylx/yate）。
MONGODB_USER_SERVER_COLLECTION=cl_mabinogi_user_server
# 群资料/成员刷新间隔，默认 6 小时。群信息与单成员查询均为 30 次/分钟。
QQ_GROUP_INFO_REFRESH_MS=21600000
# 频道资料/成员刷新间隔，默认沿用 QQ_GROUP_INFO_REFRESH_MS。GET /guilds/{guild_id} 限制 50 QPS。
QQ_GUILD_INFO_REFRESH_MS=21600000

# 老服务器只读数据库桥接
# 使用 `openssl rand -base64 32` 生成，并在新旧服务器配置相同值。
DATABASE_BRIDGE_URL=https://<OLD_SERVER_BRIDGE_HOST>
DATABASE_BRIDGE_SECRET=<BASE64_32_BYTE_SECRET>
DATABASE_BRIDGE_TIMEOUT_MS=10000
